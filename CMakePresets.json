{
  "version": 6,
  "configurePresets": [
    {
      "name": "release-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sanitize-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CSV_NATIVE_SANITIZERS": "ON"
      }
    },
    {
      "name": "darwin-arm64-release",
      "inherits": "release-base",
      "displayName": "macOS ARM64 release",
      "binaryDir": "${sourceDir}/build/darwin-arm64",
      "toolchainFile": "${sourceDir}/toolchains/darwin-arm64-clang.cmake",
      "cacheVariables": {
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/.cache/fetchcontent/darwin-arm64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "darwin-x64-release",
      "inherits": "release-base",
      "displayName": "macOS x64 release",
      "binaryDir": "${sourceDir}/build/darwin-x64",
      "toolchainFile": "${sourceDir}/toolchains/darwin-x64-clang.cmake",
      "cacheVariables": {
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/.cache/fetchcontent/darwin-x64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-x64-release",
      "inherits": "release-base",
      "displayName": "Linux x64 release",
      "binaryDir": "${sourceDir}/build/linux-x64",
      "toolchainFile": "${sourceDir}/toolchains/linux-x64-clang.cmake",
      "cacheVariables": {
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/.cache/fetchcontent/linux-x64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "darwin-arm64-sanitize",
      "inherits": "sanitize-base",
      "displayName": "macOS ARM64 sanitizers",
      "binaryDir": "${sourceDir}/build/darwin-arm64-sanitize",
      "toolchainFile": "${sourceDir}/toolchains/darwin-arm64-clang.cmake",
      "cacheVariables": {
        "CSV_NATIVE_SANITIZER_LIST": "undefined",
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/.cache/fetchcontent/darwin-arm64-sanitize"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "darwin-x64-sanitize",
      "inherits": "sanitize-base",
      "displayName": "macOS x64 sanitizers",
      "binaryDir": "${sourceDir}/build/darwin-x64-sanitize",
      "toolchainFile": "${sourceDir}/toolchains/darwin-x64-clang.cmake",
      "cacheVariables": {
        "CSV_NATIVE_SANITIZER_LIST": "undefined",
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/.cache/fetchcontent/darwin-x64-sanitize"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-x64-sanitize",
      "inherits": "sanitize-base",
      "displayName": "Linux x64 sanitizers",
      "binaryDir": "${sourceDir}/build/linux-x64-sanitize",
      "toolchainFile": "${sourceDir}/toolchains/linux-x64-clang.cmake",
      "cacheVariables": {
        "CSV_NATIVE_SANITIZER_LIST": "address,undefined",
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/.cache/fetchcontent/linux-x64-sanitize"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "darwin-arm64-release",
      "configurePreset": "darwin-arm64-release"
    },
    {
      "name": "darwin-x64-release",
      "configurePreset": "darwin-x64-release"
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64-release"
    },
    {
      "name": "darwin-arm64-sanitize",
      "configurePreset": "darwin-arm64-sanitize",
      "targets": [
        "csv_native_fuzz"
      ]
    },
    {
      "name": "darwin-x64-sanitize",
      "configurePreset": "darwin-x64-sanitize",
      "targets": [
        "csv_native_fuzz"
      ]
    },
    {
      "name": "linux-x64-sanitize",
      "configurePreset": "linux-x64-sanitize",
      "targets": [
        "csv_native_fuzz"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "darwin-arm64-sanitize",
      "configurePreset": "darwin-arm64-sanitize",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "csv_native_fuzz"
        }
      },
      "execution": {
        "timeout": 60
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:abort_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1"
      }
    },
    {
      "name": "darwin-x64-sanitize",
      "configurePreset": "darwin-x64-sanitize",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "csv_native_fuzz"
        }
      },
      "execution": {
        "timeout": 60
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:abort_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1"
      }
    },
    {
      "name": "linux-x64-sanitize",
      "configurePreset": "linux-x64-sanitize",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "csv_native_fuzz"
        }
      },
      "execution": {
        "timeout": 60
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:abort_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1"
      }
    }
  ]
}
