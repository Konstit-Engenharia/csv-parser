{
  "name": "@konstit/csv-parser",
  "version": "1.0.0",
  "description": "Bun-native CSV parser with streaming rows, filters, and aggregate batches.",
  "author": {
    "name": "KONSTIT ENGENHARIA E TECNOLOGIA LTDA",
    "email": "opensource@konstit.com.br"
  },
  "contributors": [
    {
      "name": "Diego Alcântara",
      "url": "https://github.com/dgoalcantara",
      "email": "diego.alcantara@konstit.com.br"
    },
    {
      "name": "Marcelo Marchioro",
      "url": "https://github.com/Sprayscelo",
      "email": "marcelo.marchioro@konstit.com.br"
    }
  ],
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "prebuilds",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:native": "bun scripts/build-native.ts",
    "stage:native": "bun scripts/stage-native.ts",
    "verify:native-package": "bun scripts/verify-native-package.ts",
    "prepack": "bun run verify:native-package",
    "test": "bun test",
    "test:native": "bun run build:native && bun scripts/test-native.ts",
    "test:native:sanitize": "bun scripts/test-native-sanitizers.ts",
    "bench": "bun run build:native && bun bench/csv.bench.ts",
    "bench:csv-parser:example": "bun run build:native && bun bench/csv-parser/example-file.bench.ts",
    "bench:csv-parser:worker-materialize": "bun run build:native && bun bench/csv-parser/example-file-worker-materialize.bench.ts",
    "bench:csv-parser:guard": "bun run build:native && bun bench/csv-parser/regression-guard.ts",
    "bench:csv-parser:synthetic:latin1": "bun run build:native && bun bench/csv-parser/synthetic-latin1.bench.ts",
    "bench:csv-parser:synthetic:utf8": "bun run build:native && bun bench/csv-parser/synthetic-utf8.bench.ts",
    "bench:example": "bun run build:native && bun bench/example-file.bench.ts",
    "bench:field-access": "bun run build:native && bun bench/field-access.bench.ts",
    "bench:latin1-decode": "bun run build:native && bun bench/latin1-decode.bench.ts",
    "bench:materialization:serial": "bun run build:native && bun bench/materialization-serial.bench.ts",
    "bench:multi-column-stats": "bun run build:native && bun bench/multi-column-stats.bench.ts",
    "bench:native-filters": "bun run build:native && bun bench/native-filters.bench.ts",
    "bench:native": "bun run build:native && bun scripts/native-bench.ts",
    "bench:quoted-close": "bun run build:native && bun bench/quoted-close.bench.ts",
    "bench:regression-smoke": "bun run build:native && bun bench/regression-smoke.ts",
    "bench:row-view": "bun run build:native && bun bench/row-view.bench.ts",
    "bench:synthetic:latin1": "bun run build:native && bun bench/synthetic-latin1.bench.ts",
    "bench:synthetic:utf8": "bun run build:native && bun bench/synthetic-utf8.bench.ts",
    "bench:trusted-fixed": "bun run build:native && bun bench/trusted-fixed.bench.ts",
    "bench:workers:materialize": "bun run build:native && bun bench/workers/materialization.bench.ts",
    "bench:workers:all-columns": "bun run build:native && bun bench/workers/example-file-all-columns.bench.ts",
    "bench:workers:aggregates": "bun run build:native && bun bench/workers/aggregates-api.bench.ts",
    "bench:workers:native-sink": "bun run build:native && bun bench/workers/native-sink.bench.ts",
    "bench:workers:shared-ipc": "bun run build:native && bun bench/workers/shared-ipc.bench.ts",
    "example:api:aggregates": "bun examples/api-aggregates.ts",
    "example:api:batches": "bun examples/api-batches.ts",
    "example:api:builder": "bun examples/api-builder.ts",
    "example:api:count": "bun examples/api-count.ts",
    "example:api:worker-count": "bun examples/api-worker-count.ts",
    "example:api:worker-pool": "bun examples/api-worker-pool.ts",
    "example:api:rows": "bun examples/api-rows.ts",
    "example:api:shards": "bun examples/api-shards.ts",
    "example:api:worker-rows": "bun examples/api-worker-rows.ts",
    "example:first-rows": "bun examples/print-first-rows.ts",
    "profile:cpu": "bun run build:native && mkdir -p profiles && bun --cpu-prof-md --cpu-prof-dir profiles bench/profile-runtime.ts",
    "profile:cpu:csv-parser": "bun run build:native && mkdir -p profiles && bun --cpu-prof-md --cpu-prof-dir profiles bench/csv-parser/profile-runtime.ts",
    "profile:heap": "bun run build:native && mkdir -p profiles && bun --heap-prof-md --heap-prof-dir profiles bench/profile-runtime.ts",
    "profile:heap:csv-parser": "bun run build:native && mkdir -p profiles && bun --heap-prof-md --heap-prof-dir profiles bench/csv-parser/profile-runtime.ts",
    "profile:native-memory": "bun run build:native && MIMALLOC_SHOW_STATS=1 bun bench/profile-runtime.ts",
    "tsc": "bunx --bun tsc --noEmit",
    "lint:biome": "bunx @biomejs/biome check",
    "lint:oxlint": "bunx oxlint --type-aware",
    "lint": "bun run tsc && bun run lint:biome && bun run lint:oxlint",
    "fmt": "bunx dprint fmt",
    "fmt:native": "find native bench test -type f -name '*.cpp' -print0 | xargs -0 clang-format -i"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/bun": "^1.3.14",
    "csv-spectrum": "^2.0.0",
    "csv-parser": "^3.2.1",
    "dprint": "^0.55.1",
    "mitata": "^1.0.34",
    "iconv-lite": "^0.7.3",
    "oxlint": "^1.73.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": "^1.3.14"
  }
}