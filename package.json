{
  "name": "csv-parser",
  "version": "1.0.0",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "build:native": "cmake --preset release && cmake --build --preset release",
    "test": "bun test",
    "test:native": "bun run build:native && ctest --test-dir build --output-on-failure",
    "bench": "bun run build:native && bun bench/csv.bench.ts",
    "bench:csv-parser:example": "bun run build:native && bun bench/csv-parser/example-file.bench.ts",
    "bench:csv-parser:synthetic:latin1": "bun run build:native && bun bench/csv-parser/synthetic-latin1.bench.ts",
    "bench:csv-parser:synthetic:utf8": "bun run build:native && bun bench/csv-parser/synthetic-utf8.bench.ts",
    "bench:example": "bun run build:native && bun bench/example-file.bench.ts",
    "bench:field-access": "bun run build:native && bun bench/field-access.bench.ts",
    "bench:latin1-decode": "bun run build:native && bun bench/latin1-decode.bench.ts",
    "bench:multi-column-stats": "bun run build:native && bun bench/multi-column-stats.bench.ts",
    "bench:native-filters": "bun run build:native && bun bench/native-filters.bench.ts",
    "bench:native": "bun run build:native && ./build/csv_native_bench",
    "bench:quoted-close": "bun run build:native && bun bench/quoted-close.bench.ts",
    "bench:row-view": "bun run build:native && bun bench/row-view.bench.ts",
    "bench:synthetic:latin1": "bun run build:native && bun bench/synthetic-latin1.bench.ts",
    "bench:synthetic:utf8": "bun run build:native && bun bench/synthetic-utf8.bench.ts",
    "bench:trusted-fixed": "bun run build:native && bun bench/trusted-fixed.bench.ts",
    "example:api:aggregates": "bun examples/api-aggregates.ts",
    "example:api:batches": "bun examples/api-batches.ts",
    "example:api:builder": "bun examples/api-builder.ts",
    "example:api:count": "bun examples/api-count.ts",
    "example:api:rows": "bun examples/api-rows.ts",
    "example:first-rows": "bun examples/print-first-rows.ts",
    "profile:cpu": "bun run build:native && mkdir -p profiles && bun --cpu-prof-md --cpu-prof-dir profiles bench/profile-runtime.ts",
    "profile:cpu:csv-parser": "bun run build:native && mkdir -p profiles && bun --cpu-prof-md --cpu-prof-dir profiles bench/csv-parser/profile-runtime.ts",
    "profile:heap": "bun run build:native && mkdir -p profiles && bun --heap-prof-md --heap-prof-dir profiles bench/profile-runtime.ts",
    "profile:heap:csv-parser": "bun run build:native && mkdir -p profiles && bun --heap-prof-md --heap-prof-dir profiles bench/csv-parser/profile-runtime.ts",
    "profile:native-memory": "bun run build:native && MIMALLOC_SHOW_STATS=1 bun bench/profile-runtime.ts",
    "tsc": "bunx --bun tsc --noEmit",
    "lint:biome": "bunx --bun @biomejs/biome check",
    "lint:oxlint": "bunx --bun oxlint --type-aware",
    "lint": "bun run tsc && bun run lint:biome && bun run lint:oxlint",
    "fmt": "bunx --bun dprint fmt",
    "fmt:native": "find native bench test -type f -name '*.cpp' -print0 | xargs -0 clang-format -i"
  },
  "dependencies": {
    "@drizzle-team/brocli": "^0.12.0",
    "csv-parser": "^3.2.1",
    "iconv-lite": "^0.7.2"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/bun": "1.3.14",
    "csv-spectrum": "^2.0.0",
    "dprint": "^0.55.1",
    "mitata": "^1.0.34",
    "oxlint": "^1.72.0"
  },
  "engines": {
    "bun": "^1.3.14"
  }
}
